<?xml version="1.0" encoding="UTF-8"?>
<module configVersion="1.2">

    <id>nationalhistory</id>
    <name>National History Module</name>
    <version>1.0.0-SNAPSHOT</version>
    <package>org.openmrs.module.nationalhistory</package>
    <author>OpenMRS Developers</author>
    <description>National Medical History widget and FHIR integration for patient dashboard</description>
    <require_version>2.0.* - 2.*</require_version>

    <require_modules>
        <require_module version="3.12.0">org.openmrs.module.uiframework</require_module>
        <require_module version="2.32.0">org.openmrs.module.webservices.rest</require_module>
        <require_module version="1.* - 2.*">org.openmrs.module.fhir2</require_module>
    </require_modules>

    <activator>org.openmrs.module.nationalhistory.NationalHistoryActivator</activator>

    <extension>
        <point>org.openmrs.referenceapplication.patientDashboard.secondColumnFragments</point>
        <class>org.openmrs.module.nationalhistory.extension.html.NationalHistoryDashboardExtension</class>
    </extension>

    <globalProperty>
        <property>nationalhistory.fhir.baseUrl</property>
        <defaultValue></defaultValue>
        <description>Base URL of the external MPI FHIR R4 server</description>
    </globalProperty>

    <globalProperty>
        <property>nationalhistory.fhir.token</property>
        <defaultValue></defaultValue>
        <description>Optional bearer token for the external MPI FHIR server</description>
    </globalProperty>

    <messages>
        <lang>en</lang>
        <file>messages.properties</file>
    </messages>
</module>
