<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <bean id="nationalhistory.nationalHistoryService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target">
            <bean class="org.openmrs.module.nationalhistory.api.impl.NationalHistoryServiceImpl"/>
        </property>
        <property name="preInterceptors" ref="serviceInterceptors"/>
        <property name="transactionAttributeSource" ref="transactionAttributeSource"/>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.nationalhistory.api.NationalHistoryService</value>
                <ref bean="nationalhistory.nationalHistoryService"/>
            </list>
        </property>
    </bean>
</beans>
